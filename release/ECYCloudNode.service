[Unit]
Description=ECYCloudNode Service
# 使用 network-online.target 确保网络完全可用后再启动
# 这对于需要连接面板 API 的 ECYCloudNode 非常重要
After=network-online.target nss-lookup.target
Wants=network-online.target
# 防止服务启动失败后无限重启
StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
User=root
Group=root
Type=simple
LimitAS=infinity
LimitRSS=infinity
# 进程内存里有面板 ApiKey、证书私钥与用户凭据，崩溃转储会把它们写到磁盘
LimitCORE=0
# 节点及其拉起的 iptables、检测脚本都不能经 setuid 等途径再提权
NoNewPrivileges=yes
LimitNOFILE=999999
WorkingDirectory=/usr/local/ECYCloudNode/
ExecStart=/usr/local/ECYCloudNode/ECYCloudNode --config /etc/ECYCloudNode/config.yml
# 设置合理的超时时间
TimeoutStartSec=60
TimeoutStopSec=30
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
